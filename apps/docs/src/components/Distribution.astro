---
import { getRegistryItem, type RegistryFramework } from '../lib/registry'
import CodeBlock from './CodeBlock.astro'
import type { CodeLang } from './code-lang'

interface Props {
  name: string
  framework?: RegistryFramework
}

const { name, framework = 'react' } = Astro.props
const item = getRegistryItem(name, framework)
const cli = {
  react: { command: 'shadcn@latest', name: 'shadcn', project: 'React' },
  vue: { command: 'shadcn-vue@2.8.2', name: 'shadcn-vue', project: 'Vue 3.5+' },
  svelte: { command: 'shadcn-svelte@1.8.0', name: 'shadcn-svelte', project: 'Svelte 5' },
}[framework]
const registryPath = `/r/${framework === 'react' ? '' : `${framework}/`}${item.name}.json`
const registryUrl = new URL(registryPath, Astro.site).href
const registryCommand = `npx ${cli.command} add ${registryUrl}`
const dependencyCommand = `npm install ${item.dependencies.join(' ')}`

function displayTarget(target: string): string {
  const placeholders = {
    '@ui/': 'src/components/ui/',
    '@components/': 'src/components/',
    '@hooks/': 'src/hooks/',
    '@lib/': 'src/lib/',
  }

  for (const [placeholder, replacement] of Object.entries(placeholders)) {
    if (target.startsWith(placeholder)) return target.replace(placeholder, replacement)
  }
  return target
}

function filePath(file: { path?: string; target?: string }): string {
  if (framework === 'svelte') return `src/lib/components/ui/${file.target}`
  return displayTarget(
    file.target ?? file.path?.replace('registry/vue/', 'src/components/ui/') ?? '',
  )
}

function codeLanguage(path: string): CodeLang {
  if (path.endsWith('.vue')) return 'vue'
  if (path.endsWith('.svelte')) return 'svelte'
  if (path.endsWith('.css')) return 'css'
  if (path.endsWith('.ts')) return 'ts'
  return 'tsx'
}
---

<section class="distribution" data-distribution data-framework={framework} aria-labelledby={`copy-${item.name}`}>
  <div class="distribution-head">
    <div>
      <strong id={`copy-${item.name}`}>Add to your project</strong>
      <p>Copy the component and everything it needs into your {cli.project} project.</p>
    </div>
  </div>

  <div class="distribution-source">
    <div class="distribution-label">
      <span class="distribution-badge">Recommended</span>
      <strong>Use the {cli.name} CLI</strong>
    </div>
    <CodeBlock code={registryCommand} lang="bash" />
    <p class="distribution-note">
      Run this from a project with <code>components.json</code>. The CLI creates all required files
      and installs the declared runtime dependencies. New to shadcn? Follow the
      <a href="/docs/installation">installation guide</a> first.
    </p>
    {
      framework === 'svelte' && (
        <p class="distribution-note">
          Files land in <code>src/lib/components/ui/kida</code> by default. SvelteKit 3 projects
          import them through <code>#lib</code>; SvelteKit 2 and Vite projects use{' '}
          <code>$lib</code>, as in the examples here.
        </p>
      )
    }
    <a class="registry-link" href={registryPath}>View registry JSON <span aria-hidden="true">↗</span></a>

    <details class="manual-source">
      <summary>
        <span>Copy manually</span>
        <small>{item.files.length} files</small>
      </summary>
      <div class="manual-source-body">
        {
          item.dependencies.length > 0 && (
            <div class="manual-step">
              <h3>1. Install runtime dependencies</h3>
              <CodeBlock code={dependencyCommand} lang="bash" />
            </div>
          )
        }
        <div class="manual-step">
          <h3>{item.dependencies.length > 0 ? '2. Create the source files' : '1. Create the source files'}</h3>
          <p>Keep this directory structure so the component's relative imports continue to work.</p>
          <div class="source-files">
            {
              item.files.map((file) => (
                <details>
                  <summary>{filePath(file)}</summary>
                  <CodeBlock code={file.content} lang={codeLanguage(filePath(file))} />
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </details>
  </div>
</section>
