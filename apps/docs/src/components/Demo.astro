---
import { type Framework, getDemo } from '../demos/registry'
import CodeBlock from './CodeBlock.astro'

interface Props {
  /** Basename of a file in `src/demos`, without its framework suffix or extension. */
  name: string
  framework?: Framework
  /** Shown above the stage. Defaults to the demo's name. */
  title?: string
  /** Render only the live stage, for marketing surfaces where source would distract. */
  previewOnly?: boolean
  /** Keep the titled demo chrome but let Quick start carry the basic usage code. */
  hideSource?: boolean
}

const { name, title, framework = 'react', previewOnly = false, hideSource = false } = Astro.props

// Throws on an unknown name, so a typo fails the build instead of shipping a code block
// that belongs to nothing.
const demo = getDemo(name)

const variant = demo[framework]
if (!variant) throw new Error(`Demo "${name}" has no ${framework} variant.`)
---

<figure class="demo" data-demo={name} data-preview-only={previewOnly ? '' : undefined}>
  {!previewOnly && <figcaption class="demo-head">{title ?? name}</figcaption>}

  <div class="demo-stage">
    <slot />
  </div>

  {!previewOnly && !hideSource && <CodeBlock code={variant.source} lang={variant.lang} />}
</figure>
