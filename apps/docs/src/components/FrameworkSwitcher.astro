---
interface Props {
  page: string
  framework: 'react' | 'vue'
  frameworks?: ('react' | 'vue')[]
}
const { page, framework, frameworks = ['react', 'vue'] } = Astro.props
---

<nav class="framework-switcher" aria-label="Documentation framework">
  {frameworks.includes('react') && <a href={`/docs/${page}`} aria-current={framework === 'react' ? 'page' : undefined}>React</a>}
  {frameworks.includes('vue') && <a href={`/docs/vue/${page}`} aria-current={framework === 'vue' ? 'page' : undefined}>Vue <span class="framework-badge">Experimental</span></a>}
</nav>
