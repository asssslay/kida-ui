---
interface Props {
  page: string
  framework: 'react' | 'vue' | 'svelte'
  frameworks?: ('react' | 'vue' | 'svelte')[]
}
const { page, framework, frameworks = ['react', 'vue', 'svelte'] } = Astro.props
const other = framework === 'react' ? 'vue' : 'react'
const onSvelte = framework === 'svelte'
---

<div class="framework-switcher" role="group" aria-label="Documentation framework" data-framework-page={page} data-frameworks={frameworks.join(' ')} data-framework-current={framework}>
  {onSvelte ? (
    <>
      <a href={`/docs/${page}`} data-astro-reload data-framework-preference="react" hidden={!frameworks.includes('react')}>React</a>
      <a href={`/docs/vue/${page}`} data-astro-reload data-framework-preference="vue" hidden={!frameworks.includes('vue')}>Vue</a>
      <a href={`/docs/svelte/${page}`} aria-current="page">Svelte</a>
    </>
  ) : (
    <>
      <button type="button" data-framework-choice="react" aria-controls="framework-article" aria-pressed={framework === 'react'} hidden={!frameworks.includes('react')} disabled>React</button>
      <button type="button" data-framework-choice="vue" aria-controls="framework-article" aria-pressed={framework === 'vue'} hidden={!frameworks.includes('vue')} disabled>Vue</button>
      {frameworks.includes('svelte') && <a href={`/docs/svelte/${page}`} data-astro-reload data-framework-svelte>Svelte</a>}
    </>
  )}
</div>
<p class="framework-preview-note" hidden={page === 'installation' || frameworks.length < 2 || onSvelte}>Shared live previews stay running while you switch code examples and API documentation.</p>
<p class="framework-status" data-framework-status role="status"></p>
{!onSvelte && frameworks.includes(other) && (
  <noscript>
    <p>JavaScript is required to switch documentation in place. <a href={other === 'vue' ? `/docs/vue/${page}` : `/docs/${page}`}>Read the {other === 'vue' ? 'Vue' : 'React'} documentation.</a></p>
  </noscript>
)}

<script>
  import '../lib/docs-navigation'
</script>
