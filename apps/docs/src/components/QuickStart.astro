---
import { getQuickStart } from '../lib/quick-starts'
import CodeBlock from './CodeBlock.astro'

interface Props {
  name: string
  framework?: 'react' | 'vue'
}

const { name, framework = 'react' } = Astro.props
const source = getQuickStart(name, framework)
---

<CodeBlock code={source} lang={framework === 'vue' ? 'vue' : 'tsx'} />
