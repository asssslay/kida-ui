---
import { getCollection } from 'astro:content'
import { COMPONENT_CATEGORIES, categoryOrder } from '../../config/components'
import CatalogCardPreview, {
  assertCatalogPreviewCoverage,
} from '../../demos/catalog-card-preview.react.tsx'
import Base from '../../layouts/Base.astro'

const entries = (await getCollection('components')).sort(
  (a, b) =>
    categoryOrder(a.data.category) - categoryOrder(b.data.category) ||
    a.data.order - b.data.order ||
    a.data.title.localeCompare(b.data.title),
)

const groups = COMPONENT_CATEGORIES.map((category) => ({
  ...category,
  entries: entries.filter((entry) => entry.data.category === category.id),
})).filter((group) => group.entries.length > 0)

assertCatalogPreviewCoverage(entries.map((entry) => entry.id))
---

<Base
  title="Documentation — Kida UI"
  description="Component documentation for Kida UI, the animation-first component library."
  bodyClass="soft-orbit-page docs-catalog-page"
>
  <main id="main" class="docs-catalog">
    <header class="docs-catalog-hero">
      <p class="docs-catalog-kicker">
        <span>Documentation</span>
        <span aria-hidden="true">/</span>
        <span>{entries.length.toString().padStart(2, '0')} components</span>
      </p>
      <h1>Give your interface<br /><em>a pulse.</em></h1>
      <div class="docs-catalog-intro">
        <p>
          Add polished entrances, text motion, tactile interaction, and hand-drawn details to your
          interface. Every component arrives as readable source you can make your own.
        </p>
        <a class="docs-catalog-action" href="/docs/installation">
          Start with installation <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <div class="docs-catalog-groups">
      {
        groups.map((group, index) => (
          <section class="docs-catalog-group" data-group-index={index + 1}>
            <header class="docs-catalog-group-head">
              <p>{String(index + 1).padStart(2, '0')}</p>
              <h2>{group.label}</h2>
              <span>{String(group.entries.length).padStart(2, '0')}</span>
            </header>
            <div class="docs-catalog-grid">
              {group.entries.map((entry) => (
                <CatalogCardPreview
                  name={entry.id}
                  href={`/docs/${entry.id}`}
                  label={`${entry.data.title}: ${entry.data.description}`}
                  title={entry.data.title}
                  description={entry.data.description}
                  client:visible
                />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</Base>
