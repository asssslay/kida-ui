---
import { getCollection } from 'astro:content'
import { COMPONENT_CATEGORIES, categoryOrder } from '../../config/components'
import Base from '../../layouts/Base.astro'

const entries = (await getCollection('components')).sort(
  (a, b) =>
    categoryOrder(a.data.category) - categoryOrder(b.data.category) ||
    a.data.order - b.data.order ||
    a.data.title.localeCompare(b.data.title),
)

const groups = COMPONENT_CATEGORIES.map((category) => ({
  ...category,
  entries: entries.filter((entry) => entry.data.category === category.id),
}))
---

<Base
  title="Documentation — Kida UI"
  description="Component documentation for Kida UI, the animation-first component library."
>
  <main id="main" class="sections">
    <section class="section" style="border-top: 0; padding-top: 3rem;">
      <h1>Components</h1>
      <p>
        Browse motion by what it helps you create. Primitives are available now; the first
        soft/candy editorial collection starts with text, interaction, and decorative motion.
      </p>
      <div class="catalog-groups">
        {
          groups.map((group) => (
            <section class="catalog-group">
              <div class="catalog-group-head">
                <div>
                  <h2>{group.label}</h2>
                  <p>{group.description}</p>
                </div>
                <span class="pill">{group.entries.length || 'soon'}</span>
              </div>
              {group.entries.length > 0 && (
                <div class="tiers">
                  {group.entries.map((entry) => (
                    <a class="tier" href={`/docs/${entry.id}`}>
                      <span class="pill">{entry.data.status}</span>
                      <h3>{entry.data.title}</h3>
                      <p>{entry.data.description}</p>
                    </a>
                  ))}
                </div>
              )}
            </section>
          ))
        }
      </div>
    </section>
  </main>
</Base>
