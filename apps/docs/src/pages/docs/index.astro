---
import { getCollection } from 'astro:content'
import { COMPONENT_CATEGORIES, categoryOrder } from '../../config/components'
import CatalogCardPreview from '../../demos/catalog-card-preview.react.tsx'
import Base from '../../layouts/Base.astro'

const entries = (await getCollection('components')).sort(
  (a, b) =>
    categoryOrder(a.data.category) - categoryOrder(b.data.category) ||
    a.data.order - b.data.order ||
    a.data.title.localeCompare(b.data.title),
)

const groups = COMPONENT_CATEGORIES.map((category) => ({
  ...category,
  entries: entries.filter((entry) => entry.data.category === category.id),
})).filter((group) => group.entries.length > 0)
---

<Base
  title="Documentation — Kida UI"
  description="Component documentation for Kida UI, the animation-first component library."
>
  <main id="main" class="sections catalog-page">
    <section class="section" style="border-top: 0; padding-top: 3rem;">
      <h1>Components</h1>
      <p>
        Add polished entrances, text motion, tactile interaction, and hand-drawn details to your
        interface. Choose a component to see it live and copy it into your project.
      </p>
      <div class="catalog-actions">
        <a class="button primary" href="/docs/installation">Read the installation guide</a>
      </div>
      <div class="catalog-groups">
        {
          groups.map((group) => (
            <section class="catalog-group">
              <div class="catalog-group-head">
                <h2>{group.label}</h2>
              </div>
              <div class="catalog-grid">
                {group.entries.map((entry) => (
                  <CatalogCardPreview
                    name={entry.id}
                    href={`/docs/${entry.id}`}
                    label={`${entry.data.title}: ${entry.data.description}`}
                  client:load
                  />
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>
  </main>
</Base>
