---
import { getCollection } from 'astro:content'
import CodeBlock from '../components/CodeBlock.astro'
import HeroGlyphField from '../components/HeroGlyphField.astro'
import CatalogCardPreview, {
  assertCatalogPreviewCoverage,
} from '../demos/catalog-card-preview.react.tsx'
import Base from '../layouts/Base.astro'

const entries = (await getCollection('components')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
)
assertCatalogPreviewCoverage(entries.map((entry) => entry.id))

const registryUrl = new URL('/r/text-bloom.json', Astro.site).href
const installCommand = `npx shadcn@latest add ${registryUrl}`
---

<Base
  title="Kida UI — expressive motion components for React"
  description="Playful, accessible React animation components you can copy, customize, and make your own."
  bodyClass="soft-orbit-page"
>
  <main id="main" class="soft-orbit-home">
    <section class="orbit-hero" aria-labelledby="orbit-title">
      <HeroGlyphField />

      <div class="orbit-copy">
        <h1 id="orbit-title">Interfaces should feel <em>alive</em>, not busy.</h1>
        <p class="orbit-lede">
          An expressive UI animation library for React, with source code you can make your own.
          Support for more frameworks is planned.
        </p>
        <div class="orbit-actions">
          <a class="orbit-button orbit-button-primary" href="/docs">
            Explore components <span aria-hidden="true">↗</span>
          </a>
          <a class="orbit-action-link" href="/docs/installation">
            Install for React <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="orbit-manifesto" aria-labelledby="manifesto-title">
      <p class="orbit-section-kicker">Calm at rest. Expressive on cue.</p>
      <h2 id="manifesto-title">Small motions. Distinct personalities.</h2>
      <p>
        Each component solves one interaction well—from a headline that blooms to a photo pile you
        can actually pick up. Nothing loops just to ask for attention.
      </p>
      <div class="orbit-traits" aria-label="Design principles">
        <span>Intent-led motion</span>
        <span>Source you can shape</span>
        <span>Accessible by default</span>
      </div>
    </section>

    <section id="components" class="orbit-library" aria-labelledby="library-title">
      <div class="orbit-section-head">
        <div>
          <p class="orbit-section-kicker">The collection</p>
          <h2 id="library-title">Seven components. No filler.</h2>
        </div>
        <a href="/docs">Browse all docs <span aria-hidden="true">→</span></a>
      </div>

      <div class="orbit-library-grid">
        {
          entries.map((entry) => (
            <CatalogCardPreview
              name={entry.id}
              href={`/docs/${entry.id}`}
              label={`${entry.data.title}: ${entry.data.description}`}
              title={entry.data.title}
              description={entry.data.description}
              client:visible
            />
          ))
        }
      </div>
    </section>

    <section class="orbit-install" aria-labelledby="install-title">
      <div class="orbit-install-copy">
        <p class="orbit-section-kicker">Make it yours</p>
        <h2 id="install-title">One command. Every file included.</h2>
        <p>
          Add a component through the shadcn CLI, then keep the readable React, motion, and CSS
          source inside your own project.
        </p>
        <a href="/docs/installation">Read the installation guide <span aria-hidden="true">→</span></a>
      </div>
      <div class="orbit-command-island">
        <div class="orbit-command-head">
          <span>Terminal</span>
          <span aria-hidden="true">• • •</span>
        </div>
        <CodeBlock code={installCommand} lang="bash" />
        <p><span aria-hidden="true">✓</span> Component, styles, and public dependencies included</p>
      </div>
    </section>

    <section class="orbit-closing" aria-labelledby="closing-title">
      <span class="orbit-closing-spark" aria-hidden="true">✦</span>
      <p class="orbit-section-kicker">Ready when you are</p>
      <h2 id="closing-title">Give your interface a pulse.</h2>
      <p>Start with one small interaction and make it unmistakably yours.</p>
      <a class="orbit-button orbit-button-primary" href="/docs">
        Find your component <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
</Base>
