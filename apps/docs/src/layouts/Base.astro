---
import '@kida-ui/styles/kida.css'
import '@fontsource-variable/instrument-sans'
import '@fontsource-variable/instrument-sans/wght-italic.css'
import '../styles/site.css'
import { ClientRouter } from 'astro:transitions'
import Nav from '../components/Nav.astro'

interface Props {
  title: string
  description: string
  bodyClass?: string
  canonicalPath?: string
  clientNavigation?: boolean
  /** Documentation frameworks this page can switch between. */
  frameworks?: ('react' | 'vue')[]
}

const {
  title,
  description,
  bodyClass,
  canonicalPath = Astro.url.pathname,
  clientNavigation = false,
  frameworks = [],
} = Astro.props
const canonical = new URL(canonicalPath, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {clientNavigation && <>
      <script is:inline data-frameworks={frameworks.join(' ')}>
        // Normalize compatibility entries before the router reads its initial URL.
        if (location.pathname.startsWith('/docs/vue/')) {
          history.replaceState(history.state, '', location.pathname.replace('/docs/vue/', '/docs/') + location.search + location.hash)
        } else if (document.currentScript?.dataset.frameworks?.split(' ').includes('vue')) {
          // A saved Vue preference replaces this React article right after load.
          // Hide its text until then (docs-navigation clears this); the timeout
          // keeps the page readable if that script never runs.
          try {
            if (localStorage.getItem('kida-ui:framework') === 'vue') {
              const root = document.documentElement
              root.setAttribute('data-framework-pending', '')
              setTimeout(() => root.removeAttribute('data-framework-pending'), 4000)
            }
          } catch {}
        }
      </script>
      <ClientRouter fallback="swap" />
    </>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <slot />
    <footer class="site-footer">
      <p>MIT licensed · built with Kida UI</p>
    </footer>
  </body>
</html>
