---
import { getCollection } from 'astro:content'
import type { MarkdownHeading } from 'astro'
import FrameworkSwitcher from '../components/FrameworkSwitcher.astro'
import { COMPONENT_CATEGORIES, categoryOrder } from '../config/components'
import Base from './Base.astro'

interface Props {
  title: string
  description: string
  currentPath: string
  headings: MarkdownHeading[]
  framework?: 'react' | 'vue'
  frameworkPage?: string
}

const {
  title,
  description,
  currentPath,
  headings,
  framework = 'react',
  frameworkPage,
} = Astro.props
const docsPrefix = '/docs'

const entries = (await getCollection('components')).sort(
  (a, b) =>
    categoryOrder(a.data.category) - categoryOrder(b.data.category) ||
    a.data.order - b.data.order ||
    a.data.title.localeCompare(b.data.title),
)

const groups = COMPONENT_CATEGORIES.map((category) => ({
  ...category,
  entries: entries.filter((item) => item.data.category === category.id),
})).filter((category) => category.entries.length > 0)

// h2 carries the page outline and h3 sits under it; anything deeper would make the rail
// longer than the section it points at.
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
---

<Base
  title={`${title} — Kida UI`}
  description={description}
  bodyClass="soft-orbit-page docs-reference-page"
  canonicalPath={currentPath}
  clientNavigation
>
  <div class="docs">
    <aside class="sidebar">
      <h2>Documentation</h2>
      <section class="sidebar-group">
        <h3>Getting started</h3>
        <ul>
          <li>
            <a href="/docs" aria-current={currentPath === '/docs' ? 'page' : undefined}>
              Components
            </a>
          </li>
          <li>
            <a
              data-framework-link
              href={`${docsPrefix}/installation`}
              aria-current={currentPath === `${docsPrefix}/installation` ? 'page' : undefined}
            >
              Installation
            </a>
          </li>
        </ul>
      </section>
      {
        groups.map((group) => (
          <section class="sidebar-group">
            <h3>{group.label}</h3>
            <ul>
              {group.entries.map((item) => (
                <li>
                  <a
                    data-framework-link
                    href={`${docsPrefix}/${item.id}`}
                    aria-current={currentPath === `${docsPrefix}/${item.id}` ? 'page' : undefined}
                  >
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </aside>

    <main class="prose" id="main">
      <header class="docs-prose-head">
        <p class="docs-prose-kicker">
          <a href="/docs">Documentation</a><span aria-hidden="true">/</span>{title}
        </p>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
      </header>
      {frameworkPage && <FrameworkSwitcher page={frameworkPage} framework={framework} />}
      <slot />
    </main>

    <aside class="toc">
      <h2>On this page</h2>
      <ul>
        {
          toc.map((heading) => (
            <li data-depth={heading.depth}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Base>
