{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["SITE_URL", "RENDER_EXTERNAL_URL"],
      "inputs": [
        "src/**",
        "public/**",
        "*.css",
        "package.json",
        "tsdown.config.ts",
        "tsconfig.json",
        "tsconfig.build.json",
        "vite.config.ts",
        "scripts/**",
        "astro.config.mjs"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "@kida-ui/playground#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/docs/src/demos/dual-wave-playground.react.tsx",
        "$TURBO_ROOT$/apps/docs/src/demos/dual-wave-photos.ts",
        "$TURBO_ROOT$/apps/docs/src/demos/dual-wave.css",
        "$TURBO_ROOT$/apps/docs/public/demo/dual-wave/**"
      ],
      "outputs": ["dist/**"]
    },
    "@kida-ui/playground#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/docs/src/demos/dual-wave-playground.react.tsx",
        "$TURBO_ROOT$/apps/docs/src/demos/dual-wave-photos.ts"
      ]
    },
    "@kida-ui/vue#typecheck": { "dependsOn": ["build"] },
    "test": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true }
  }
}
