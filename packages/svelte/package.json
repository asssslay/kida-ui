{
  "name": "@kida-ui/svelte",
  "version": "0.0.0",
  "private": true,
  "description": "Svelte 5 adapters for the Kida UI animation catalog.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm build && vitest run --config vitest.ssr.config.ts && vitest run"
  },
  "dependencies": {
    "@kida-ui/motion": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.46.4"
  },
  "devDependencies": {
    "@kida-ui/react": "workspace:*",
    "@kida-ui/styles": "workspace:*",
    "@sveltejs/package": "3.0.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.4.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "pngjs": "7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-browser-svelte": "3.1.0"
  }
}
