{
  "name": "@kida-ui/react",
  "version": "0.0.0",
  "description": "React adapter and components for Kida UI. The only React surface in the library (ADR D3a).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kida-ui/motion": "workspace:*",
    "@zag-js/presence": "^1.43.3",
    "@zag-js/react": "^1.43.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@kida-ui/styles": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vitest-browser-react": "^2.2.0"
  }
}
